# package.manifest — paquete de skills de fábrica v1 (gramática v1, plan paquete v1)
# Canónico: repo motor talent-factory (skills/). Los repos de producto reciben el NÚCLEO
# vía sync-package.sh; los overlays declarados abajo son POR-REPO (ni se copian ni se borran).
# La DISTRIBUCIÓN (ZIP) no trae NINGÚN overlay (validate-package.sh --estado distribucion los rechaza si
# aparecen) y cada overlay exacto viaja como plantilla `<ruta>.example` con marcadores PENDIENTE-*; la
# instancia adjudica los suyos (validate-package.sh --estado instancia los exige presentes).
# Editar este archivo = superficie sensible (D6c); recortes disparan las anclas cruzadas
# de skill-creator/invariants.tsv y el guard anti-reducción del motor.
version=1.7.3
min_invariants=6
member=linear-skill
member=skill-creator
member=talent-buzz
member=talent-ceo
member=talent-channel-operation
member=talent-channels
member=talent-context
member=talent-coordination
member=talent-issue-craft
member=talent-llm-local
member=talent-memoria
member=talent-merger
member=talent-orchestrator
member=talent-pm
member=talent-prd
member=talent-repo-onboarding
# Overlays por repo (censo P0 2026-07-23 — evidencia en el PR):
overlay=talent-channel-operation:scripts/repo-identity.conf
overlay-prefix=talent-channel-operation:references/anexo-
overlay=talent-orchestrator:scripts/repo-identity.conf
overlay-prefix=talent-merger:references/anexo-
overlay-prefix=talent-ceo:references/anexo-
