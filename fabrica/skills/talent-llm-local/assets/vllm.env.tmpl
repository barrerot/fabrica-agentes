# Entorno del contenedor del motor. Contiene la clave INTERNA del motor, asi que
# este fichero va en modo 0600: es el sitio correcto para ella, porque un fichero
# restringido no lo lee cualquiera y un argumento de proceso si.
# Las claves de los cinco usuarios no estan aqui: las guarda el medidor.
VLLM_API_KEY=@@UPSTREAM_KEY@@
# El mismo valor con el nombre que espera el medidor (lo lee de este fichero).
UPSTREAM_KEY=@@UPSTREAM_KEY@@

CUDA_DEVICE_ORDER=PCI_BUS_ID

# Sin NVLink y con las tarjetas colgando del chipset no hay acceso directo entre
# GPU (nvidia-smi topo -p2p rw devuelve CNS). Dejar que NCCL lo intente cuesta
# arranques fallidos y cuelgues; se desactiva a proposito.
NCCL_P2P_DISABLE=1
NCCL_IB_DISABLE=1

# DeepGEMM no aporta en esta topologia y añade riesgo de kernels no soportados.
VLLM_USE_DEEP_GEMM=0

# Una vez descargados los pesos, no se vuelve a salir a la red: arranques mas
# rapidos y deterministas. Comentar esta linea para cambiar de modelo.
HF_HUB_OFFLINE=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
