diff --git a/mobile/lib/shared/relay/relay_url_policy.dart b/mobile/lib/shared/relay/relay_url_policy.dart
new file mode 100644
index 0000000..4271dc4
--- /dev/null
+++ b/mobile/lib/shared/relay/relay_url_policy.dart
@@ -0,0 +1,130 @@
+/// Single authority for relay URL validation and WebSocket scheme
+/// normalization.
+///
+/// Cleartext schemes (`ws`/`http`) are only accepted towards:
+///  - [kAuthorizedCleartextHost], the exact MagicDNS host injected at build
+///    time (the same single source that fills
+///    `android/app/src/main/res/xml/network_security_config.xml`), and
+///  - IP literals inside the CGNAT/tailnet range 100.64.0.0/10.
+///
+/// Every other host must use `wss`/`https`. Android enforces the same
+/// boundary at the platform layer through the network security config, so
+/// this policy and the OS agree on which endpoints may go unencrypted.
+library;
+
+/// Exact host allowed to use cleartext schemes, injected by the build
+/// tooling. An unsubstituted placeholder (it contains `_`, impossible in a
+/// MagicDNS hostname) authorizes nothing: fail closed.
+const String kAuthorizedCleartextHost = 'TB_CLEARTEXT_HOST_PLACEHOLDER';
+
+abstract final class RelayUrlPolicy {
+  static const Set<String> _cleartextSchemes = {'ws', 'http'};
+  static const Set<String> _encryptedSchemes = {'wss', 'https'};
+
+  /// Explicit scheme normalization for the WebSocket handshake:
+  /// {http -> ws, https -> wss, ws -> ws, wss -> wss}. Anything else is a
+  /// [FormatException]. `wss` MUST map to `wss` — mapping it to `ws` would
+  /// silently downgrade an encrypted pairing to cleartext.
+  static String toWebSocketScheme(String scheme) {
+    switch (scheme) {
+      case 'http' || 'ws':
+        return 'ws';
+      case 'https' || 'wss':
+        return 'wss';
+      default:
+        throw FormatException('Invalid URL scheme: $scheme');
+    }
+  }
+
+  /// Whether [host] is an IPv4 literal inside 100.64.0.0/10 (CGNAT, used by
+  /// tailnets). Traffic to these addresses never leaves the WireGuard mesh.
+  static bool isTailnetIp(String host) {
+    final octets = _ipv4Octets(host);
+    return octets != null &&
+        octets[0] == 100 &&
+        octets[1] >= 64 &&
+        octets[1] <= 127;
+  }
+
+  /// Whether [host] is an IPv4 literal inside the RFC1918 private ranges or
+  /// 169.254/16 link-local — the upstream SSRF guard this policy preserves
+  /// (security round, finding 5): a pairing payload must not be able to point
+  /// the app at internal infrastructure, with ANY scheme. The tailnet range
+  /// 100.64.0.0/10 is deliberately NOT here: it is this deployment's own
+  /// network and has its own cleartext rules.
+  static bool isPrivateIp(String host) {
+    final octets = _ipv4Octets(host);
+    if (octets == null) return false;
+    final a = octets[0];
+    final b = octets[1];
+    if (a == 10) return true;
+    if (a == 172 && b >= 16 && b <= 31) return true;
+    if (a == 192 && b == 168) return true;
+    if (a == 169 && b == 254) return true;
+    return false;
+  }
+
+  static List<int>? _ipv4Octets(String host) {
+    final parts = host.split('.');
+    if (parts.length != 4) return null;
+    final octets = <int>[];
+    for (final part in parts) {
+      final value = int.tryParse(part);
+      if (value == null || value < 0 || value > 255) return null;
+      octets.add(value);
+    }
+    return octets;
+  }
+
+  /// Validate a relay URL against the cleartext authority.
+  ///
+  /// Throws [FormatException] when the URL is not acceptable. Localhost is
+  /// only allowed when [allowLocalhost] is true (debug builds).
+  static void validate(
+    String url, {
+    String authorizedCleartextHost = kAuthorizedCleartextHost,
+    bool allowLocalhost = false,
+  }) {
+    final uri = Uri.parse(url);
+    final scheme = uri.scheme;
+    if (!_cleartextSchemes.contains(scheme) &&
+        !_encryptedSchemes.contains(scheme)) {
+      throw FormatException('Invalid URL scheme: $scheme');
+    }
+
+    final host = uri.host.toLowerCase();
+    if (host.isEmpty) {
+      throw const FormatException('Relay URL has no host');
+    }
+    if (host == 'localhost' || host == '127.0.0.1' || host == '::1') {
+      if (!allowLocalhost) {
+        throw const FormatException('Relay URL cannot target localhost');
+      }
+      return;
+    }
+
+    // SSRF guard restored (security round, finding 5): private/link-local
+    // addresses are rejected for EVERY scheme — wss to internal
+    // infrastructure is as much an SSRF primitive as ws.
+    if (isPrivateIp(host)) {
+      throw const FormatException(
+        'Relay URL cannot target private network addresses',
+      );
+    }
+
+    if (_encryptedSchemes.contains(scheme)) return;
+
+    // Cleartext: only the injected MagicDNS host or a tailnet IP. A hostname
+    // containing `_` can never be a real authorized host, so an
+    // unsubstituted placeholder matches nothing.
+    final authorized = authorizedCleartextHost.toLowerCase();
+    final authorizedIsUsable =
+        authorized.isNotEmpty && !authorized.contains('_');
+    if (authorizedIsUsable && host == authorized) return;
+    if (isTailnetIp(host)) return;
+
+    throw const FormatException(
+      'Cleartext relay URL not allowed for this host (use wss)',
+    );
+  }
+}
