diff --git a/mobile/test/shared/relay/relay_url_policy_test.dart b/mobile/test/shared/relay/relay_url_policy_test.dart
new file mode 100644
index 0000000..30786c2
--- /dev/null
+++ b/mobile/test/shared/relay/relay_url_policy_test.dart
@@ -0,0 +1,175 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:buzz/shared/relay/relay_url_policy.dart';
+
+/// Scheme x host matrix for the single cleartext authority.
+void main() {
+  group('RelayUrlPolicy.toWebSocketScheme', () {
+    test('normalizes every accepted scheme explicitly', () {
+      expect(RelayUrlPolicy.toWebSocketScheme('http'), 'ws');
+      expect(RelayUrlPolicy.toWebSocketScheme('https'), 'wss');
+      expect(RelayUrlPolicy.toWebSocketScheme('ws'), 'ws');
+      expect(RelayUrlPolicy.toWebSocketScheme('wss'), 'wss');
+    });
+
+    test('never downgrades wss to ws', () {
+      // Regression guard for the old `https ? wss : ws` ternary, which
+      // mapped an explicit wss:// pairing URL to cleartext ws://.
+      expect(RelayUrlPolicy.toWebSocketScheme('wss'), isNot('ws'));
+    });
+
+    test('rejects unknown schemes', () {
+      for (final scheme in ['ftp', 'file', 'javascript', '']) {
+        expect(
+          () => RelayUrlPolicy.toWebSocketScheme(scheme),
+          throwsFormatException,
+          reason: 'scheme $scheme must be rejected',
+        );
+      }
+    });
+  });
+
+  group('RelayUrlPolicy.isTailnetIp', () {
+    test('accepts the 100.64.0.0/10 range boundaries', () {
+      expect(RelayUrlPolicy.isTailnetIp('100.64.0.0'), isTrue);
+      expect(RelayUrlPolicy.isTailnetIp('100.100.1.2'), isTrue);
+      expect(RelayUrlPolicy.isTailnetIp('100.127.255.255'), isTrue);
+    });
+
+    test('rejects everything outside the range', () {
+      expect(RelayUrlPolicy.isTailnetIp('100.63.255.255'), isFalse);
+      expect(RelayUrlPolicy.isTailnetIp('100.128.0.0'), isFalse);
+      expect(RelayUrlPolicy.isTailnetIp('10.0.0.1'), isFalse);
+      expect(RelayUrlPolicy.isTailnetIp('192.168.1.1'), isFalse);
+      expect(RelayUrlPolicy.isTailnetIp('example.com'), isFalse);
+      expect(RelayUrlPolicy.isTailnetIp('100.64.0'), isFalse);
+      expect(RelayUrlPolicy.isTailnetIp('100.64.0.256'), isFalse);
+    });
+  });
+
+  group('RelayUrlPolicy.validate', () {
+    const authorized = 'relay.tail1234.ts.net';
+
+    void ok(String url) =>
+        RelayUrlPolicy.validate(url, authorizedCleartextHost: authorized);
+
+    void rejected(String url, {String? reason}) => expect(
+      () => RelayUrlPolicy.validate(url, authorizedCleartextHost: authorized),
+      throwsFormatException,
+      reason: reason ?? url,
+    );
+
+    test('cleartext to the authorized MagicDNS host is accepted', () {
+      ok('ws://$authorized');
+      ok('http://$authorized:80');
+      // Hostname comparison is case-insensitive.
+      ok('ws://RELAY.TAIL1234.TS.NET');
+    });
+
+    test('cleartext to a tailnet IP is accepted', () {
+      ok('ws://100.100.1.2');
+      ok('http://100.64.0.1:80');
+    });
+
+    test('cleartext to a NON-authorized MagicDNS host is rejected', () {
+      rejected('ws://otro.tail1234.ts.net');
+    });
+
+    test('cleartext to a public host is rejected', () {
+      rejected('ws://example.com');
+      rejected('http://example.com');
+    });
+
+    test('cleartext to RFC1918 / link-local addresses is rejected', () {
+      for (final ip in [
+        '10.0.0.1',
+        '172.16.0.1',
+        '192.168.1.1',
+        '169.254.169.254',
+      ]) {
+        rejected('ws://$ip:3000', reason: 'must reject ws to $ip');
+        rejected('http://$ip:3000', reason: 'must reject http to $ip');
+      }
+    });
+
+    test('encrypted schemes are accepted for public hosts', () {
+      ok('wss://example.com');
+      ok('https://example.com');
+      ok('wss://$authorized');
+      ok('wss://100.100.1.2');
+    });
+
+    test('private/link-local addresses are rejected for EVERY scheme', () {
+      // SSRF guard restored (security round, finding 5): before the fix
+      // `wss://10.0.0.1` was accepted — encrypted schemes returned OK for
+      // any host. Red/green anchor of the fix.
+      for (final ip in [
+        '10.0.0.1',
+        '172.16.0.1',
+        '192.168.1.1',
+        '169.254.169.254',
+      ]) {
+        for (final scheme in ['ws', 'http', 'wss', 'https']) {
+          rejected('$scheme://$ip:3000', reason: 'must reject $scheme to $ip');
+        }
+      }
+    });
+
+    test('unknown schemes are rejected', () {
+      rejected('file:///etc/passwd');
+      rejected('ftp://example.com');
+    });
+
+    test('localhost is only allowed when allowLocalhost is set', () {
+      for (final host in ['localhost', '127.0.0.1']) {
+        expect(
+          () => RelayUrlPolicy.validate(
+            'ws://$host:3000',
+            authorizedCleartextHost: authorized,
+          ),
+          throwsFormatException,
+          reason: 'release must reject $host',
+        );
+        RelayUrlPolicy.validate(
+          'ws://$host:3000',
+          authorizedCleartextHost: authorized,
+          allowLocalhost: true,
+        );
+      }
+    });
+
+    test('an unsubstituted placeholder authorizes nothing (fail closed)', () {
+      // Even a URL whose host literally equals the placeholder must be
+      // rejected: the placeholder contains `_` and is never usable.
+      expect(
+        () => RelayUrlPolicy.validate(
+          'ws://tb_cleartext_host_placeholder',
+          authorizedCleartextHost: kAuthorizedCleartextHost,
+        ),
+        throwsFormatException,
+      );
+      expect(
+        () => RelayUrlPolicy.validate(
+          'ws://example.com',
+          authorizedCleartextHost: kAuthorizedCleartextHost,
+        ),
+        throwsFormatException,
+      );
+    });
+
+    test('an empty authorized host authorizes no hostname', () {
+      expect(
+        () => RelayUrlPolicy.validate(
+          'ws://example.com',
+          authorizedCleartextHost: '',
+        ),
+        throwsFormatException,
+      );
+      // The tailnet range keeps working without an authorized hostname.
+      RelayUrlPolicy.validate('ws://100.100.1.2', authorizedCleartextHost: '');
+    });
+
+    test('URLs without a host are rejected', () {
+      rejected('ws://');
+    });
+  });
+}
