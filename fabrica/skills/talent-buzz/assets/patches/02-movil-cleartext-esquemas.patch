+<?xml version="1.0" encoding="utf-8"?>
+<!-- Platform-level cleartext authority. Cleartext is OFF by default; the
+     only authorized <domain> entries are injected at build time from the
+     same single source as the Dart constant kAuthorizedCleartextHost
+     (lib/shared/relay/relay_url_policy.dart). A build that ships the
+     unsubstituted placeholder authorizes no cleartext host at all. -->
+<network-security-config>
+    <base-config cleartextTrafficPermitted="false" />
+    <domain-config cleartextTrafficPermitted="true">
+        <domain includeSubdomains="false">TB_CLEARTEXT_HOST_PLACEHOLDER</domain>
+    </domain-config>
+</network-security-config>
