+/// Publish a turn's unpublished narration as a plain channel message.
+///
+/// Companion to [`AcpClient::take_turn_reply`]: when a buzz-agent turn ends
+/// with streamed text but no publishing CLI command, this posts that text so
+/// the reply is not silently lost.
+async fn publish_fallback_reply(ctx: &PromptContext, channel_id: uuid::Uuid, text: &str) {
+    use nostr::{EventBuilder, Kind, Tag};
+    const MAX_FALLBACK_BYTES: usize = 4000;
+    let mut body = text.to_string();
+    if body.len() > MAX_FALLBACK_BYTES {
+        let mut cut = MAX_FALLBACK_BYTES;
+        while !body.is_char_boundary(cut) {
+            cut -= 1;
+        }
+        body.truncate(cut);
+        body.push('…');
+    }
+    let h_tag = match Tag::parse(["h", &channel_id.to_string()]) {
+        Ok(t) => t,
+        Err(e) => {
+            tracing::warn!(target: "pool::fallback", "h tag build failed: {e}");
+            return;
+        }
+    };
+    let event = match EventBuilder::new(Kind::Custom(9), body)
+        .tags([h_tag])
+        .sign_with_keys(&ctx.agent_keys)
+    {
+        Ok(e) => e,
+        Err(e) => {
+            tracing::warn!(target: "pool::fallback", "fallback reply sign failed: {e}");
+            return;
+        }
+    };
+    match tokio::time::timeout(
+        std::time::Duration::from_secs(5),
+        ctx.rest_client.submit_event(&event),
+    )
+    .await
+    {
+        Ok(Ok(_)) => {
+            tracing::info!(target: "pool::fallback", %channel_id, "published fallback reply")
+        }
+        Ok(Err(e)) => {
+            tracing::warn!(target: "pool::fallback", "fallback reply publish failed: {e}")
+        }
+        Err(_) => tracing::warn!(target: "pool::fallback", "fallback reply publish timed out"),
+    }
+}
