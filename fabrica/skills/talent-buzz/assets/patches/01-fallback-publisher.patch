+/// Whether a shell command invoked a Buzz CLI publishing subcommand.
+///
+/// Whitespace-normalized so `buzz   messages  send` (extra spaces, tabs,
+/// line-wrapped commands) still counts — a missed detection here means the
+/// fallback double-posts the agent's reply.
+fn is_publishing_command(cmd: &str) -> bool {
+    // Shell line-continuations (`\` + newline) become plain whitespace before
+    // token-normalization, so wrapped commands still match.
+    let unfolded = cmd.replace("\\\n", " ");
+    let normalized = unfolded.split_whitespace().collect::<Vec<_>>().join(" ");
+    if normalized.contains("buzz messages send")
+        || normalized.contains("buzz canvas set")
+        || normalized.contains("buzz notes set")
+        || normalized.contains("buzz notes rm")
+        || normalized.contains("buzz reactions add")
+    {
+        return true;
+    }
+    // `buzz-publicar` (helper del skill: publica ./respuesta.txt por stdin)
+    // solo cuenta en POSICION DE COMANDO — primer token, o precedido por un
+    // separador/wrapper de shell o una asignacion de entorno. Una mera
+    // mencion dentro de texto (`echo "usa buzz-publicar"`) NO cuenta: contarla
+    // silenciaria el fallback en un turno que jamas publico.
+    let tokens: Vec<&str> = normalized.split(' ').collect();
+    tokens.iter().enumerate().any(|(i, t)| {
+        let is_helper = *t == "buzz-publicar" || t.ends_with("/buzz-publicar");
+        if !is_helper {
+            return false;
+        }
+        // Camina hacia atras saltando tokens TRANSPARENTES en posicion de
+        // comando (asignaciones VAR=x y argumentos numericos de wrappers
+        // como `timeout 30`): lo que quede decide si es una invocacion.
+        let mut j = i;
+        while j > 0 {
+            let prev = tokens[j - 1];
+            if prev.contains('=') || prev.chars().all(|c| c.is_ascii_digit()) {
+                j -= 1;
+                continue;
+            }
+            return matches!(
+                prev,
+                "&&" | "||"
+                    | ";"
+                    | "|"
+                    | "&"
+                    | "then"
+                    | "else"
+                    | "do"
+                    | "("
+                    | "{"
+                    | "exec"
+                    | "sudo"
+                    | "env"
+                    | "command"
+                    | "nohup"
+                    | "timeout"
+            ) || prev.ends_with(';')
+                || prev.ends_with('|')
+                || prev.ends_with('&');
+        }
+        true
+    })
+}
+
+/// Whether a `tool_call_update` reports a FAILED tool run.
+///
+/// Two real shapes count as failure (review M8, PR #22): an explicit
+/// `status: "failed"|"error"`, and buzz-agent's normal error representation —
+/// `status: "completed"` with `rawOutput.isError: true` (see buzz-agent's
+/// `emit_completed`, which always reports "completed" and carries the error
+/// bit in the raw output).
+fn tool_update_is_failure(status: &str, update: &serde_json::Value) -> bool {
+    matches!(status, "failed" | "error") || update["rawOutput"]["isError"].as_bool() == Some(true)
+}
+
+/// Decision core of the fallback publisher, kept pure so the contract is
+/// unit-testable: a turn that already published via CLI never falls back,
+/// and thought text is not an input at all — the caller discards it.
+fn resolve_turn_reply(saw_publish: bool, message: &str) -> Option<String> {
+    if saw_publish {
+        return None;
+    }
+    let message = message.trim();
+    if message.is_empty() {
+        None
+    } else {
+        Some(message.to_string())
+    }
+}
