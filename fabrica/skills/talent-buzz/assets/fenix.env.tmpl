# fenix.env — orquestador Claude residente en Buzz (harness claude-agent-acp).
# Nace 0600. Los @PLACEHOLDERS@ los rellena montar.sh; BUZZ_AUTH_TAG se anade
# despues con compute_auth_tag (ver SKILL.md) — sin owner+auth-tag, memoria,
# metricas y kill-switches de chat son no-ops SILENCIOSOS.
BUZZ_PRIVATE_KEY=@FENIX_NSEC@
BUZZ_RELAY_URL=@RELAY_URL@
# Ruta EFECTIVA resuelta por montar.sh tras instalar (npm global puede caer en
# /usr/bin, /usr/local/bin u otro prefix; una ruta fija dejaria a Fenix mudo).
BUZZ_ACP_AGENT_COMMAND=@CLAUDE_ACP@
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_RESPOND_TO=allowlist
# Allowlist: pubkeys hex separadas por coma (dueno; anade aqui a quien pueda despertarlo)
BUZZ_ACP_RESPOND_TO_ALLOWLIST=@OWNER_PUBKEY@
BUZZ_ACP_AGENT_OWNER=@OWNER_PUBKEY@
BUZZ_ACP_TEAM_INSTRUCTIONS=Eres el orquestador del equipo. Publicas con el CLI `buzz`. Nada se aplica sin aprobacion nombrada del dueno; tu salida por defecto es un borrador. Si mas adelante hay especialistas (extension hermes), delega y no ejecutes: roles.py reescribe esta clave.
# Candado: el harness se niega a arrancar en modos mas abiertos que estos
BUZZ_ACP_ALLOWED_RESPOND_TO=owner-only,allowlist
# BUZZ_AUTH_TAG=<pendiente: compute_auth_tag firmado por el dueno>
