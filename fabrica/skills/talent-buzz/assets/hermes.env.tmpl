# hermes-N.env — agente especialista con modelo local (extension hermes).
# Ver references/extension-hermes.md. Nace 0600. El prompt de rol y las
# team-instructions los escribe scripts/roles.py (idempotente): no los edites aqui.
BUZZ_PRIVATE_KEY=@HERMES_NSEC@
BUZZ_RELAY_URL=@RELAY_URL@
BUZZ_ACP_AGENT_COMMAND=/usr/local/bin/buzz-agent
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_RESPOND_TO=allowlist
# Topologia en estrella anti-bucle: dueno + orquestador (+ relay para workflows).
# PROHIBIDO poner aqui a otros hermes: los bucles se evitan por estructura.
BUZZ_ACP_RESPOND_TO_ALLOWLIST=@OWNER_PUBKEY@,@FENIX_PUBKEY@,@RELAY_PUBKEY@
BUZZ_AGENT_PROVIDER=openai
# Cerebro: endpoint OpenAI-compatible. Con el skill talent-llm-local del mismo
# paquete: http://127.0.0.1:8001/v1 y una clave por agente (contabilidad por usuario).
OPENAI_COMPAT_API_KEY=@LLM_API_KEY@
OPENAI_COMPAT_MODEL=@LLM_MODEL@
OPENAI_COMPAT_BASE_URL=@LLM_BASE_URL@
OPENAI_COMPAT_API=chat
# Techos anti-cuadratico (sin prefix caching cada turno reprocesa la sesion entera):
BUZZ_AGENT_MAX_CONTEXT_TOKENS=48000
BUZZ_AGENT_MAX_OUTPUT_TOKENS=16384
BUZZ_AGENT_LLM_TIMEOUT_SECS=600
BUZZ_ACP_MAX_TURNS_PER_SESSION=8
BUZZ_ACP_CONTEXT_MESSAGE_LIMIT=6
BUZZ_ACP_MULTIPLE_EVENT_HANDLING=queue
# AUTORIDAD DE NO-CONCURRENCIA (ronda de seguridad, M4): el protocolo
# centinela de buzz-publicar NO tiene exclusion mutua propia — str_replace
# hace lectura->validacion->persistencia y dos turnos PARALELOS sobre el
# mismo respuesta.txt podrian mezclarse (TOCTOU, demostrado en
# tests/probar-publicacion.sh). Con UN subproceso por instancia los turnos
# se serializan y la carrera es imposible por configuracion. Este pin es un
# RATCHET: subirlo requiere darle al protocolo un CAS real por turno.
BUZZ_ACP_AGENTS=1
BUZZ_ACP_DEDUP=queue
BUZZ_ACP_MCP_COMMAND=/usr/local/bin/buzz-dev-mcp
BUZZ_ACP_AGENT_OWNER=@OWNER_PUBKEY@
BUZZ_ACP_ALLOWED_RESPOND_TO=owner-only,allowlist
# BUZZ_AUTH_TAG=<compute_auth_tag firmado por el dueno>
# ── Variante heartbeat (solo para un rol de operacion tipo Vigia) ────────────
# El heartbeat NO recibe memoria ni canvas: el prompt debe ser autocontenido, y
# la regla de oro es "si todo esta sano, NO publiques nada".
# BUZZ_ACP_HEARTBEAT_INTERVAL=900
# BUZZ_ACP_HEARTBEAT_PROMPT=Chequeo periodico autocontenido: revisa servicios/disco/GPU con tus herramientas. Si TODO esta sano, termina el turno SIN publicar. Solo publica (buzz messages send --channel <uuid>) si hay un problema concreto, con comando+salida.
